      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 6,
      "text": "OPCIÓN RAPIDA:\nASUMO QUE LA GANANCIA DIRECTA ES MUY ALTA, POR\nLO QUE LA GANANCIA REALIMENTADA QUEDA DADA COMO 1/BETA\n\nOPCIÓN LENTA:\nVERIFICO QUE REALMENTE LA GANANCIA DIRECTA SEA GRANDE\nCALCULANDOLA, Y DESPUES SACO LA GANANCIA REALIMENTADA\nCOMO A/1+AB (QUE JUSTAMENTE VA A DAR APROX 1/BETA)\n\nVOY A AHACER LA OPCIÓN LENTA XQ SINO NO TIENE GRACIA.\nADEMÁS ME SIRVE PARA REPASAR AMPLIS DIFERENCIALES.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OPCIÓN RAPIDA:\nASUMO QUE LA GANANCIA DIRECTA ES MUY ALTA, POR\nLO QUE LA GANANCIA REALIMENTADA QUEDA DADA COMO 1/BETA\n\nOPCIÓN LENTA:\nVERIFICO QUE REALMENTE LA GANANCIA DIRECTA SEA GRANDE\nCALCULANDOLA, Y DESPUES SACO LA GANANCIA REALIMENTADA\nCOMO A/1+AB (QUE JUSTAMENTE VA A DAR APROX 1/BETA)\n\nVOY A AHACER LA OPCIÓN LENTA XQ SINO NO TIENE GRACIA.\nADEMÁS ME SIRVE PARA REPASAR AMPLIS DIFERENCIALES.",
      "autoResize": true,
      "lineHeight": 1.35
    },
