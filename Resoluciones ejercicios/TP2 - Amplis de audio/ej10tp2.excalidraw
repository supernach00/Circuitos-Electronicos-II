    {
      "type": "text",
      "version": 1345,
      "versionNonce": 2005002095,
      "index": "c56m",
      "isDeleted": false,
      "id": "-xOQmu2hUIDYb52G-5ena",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1580.2569273198249,
      "y": 1148.8001896194548,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1370.9156494140625,
      "height": 923.4,
      "seed": 755259279,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1726748673379,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 6,
      "text": "LA REALIMENTACIÓN SE DA DESDE EL PUNTO F\nMIDIENDO LA TENSIÓN DE SALIDA, PASANDO POR UN\nBLOQUE BETA QUE ES UN DIVISOR RESISITVO,\nY SE REALIMENTA TENSIÓN.\nCOMO VEO QUE SE REALIMENTA TENSIÓN?\nEN REALIDAD NO ESTOY MUY SEGURO ASI QUE VAMOS A \nANALIZAR:\nEl diferencial tiene una corriente de emisor fija.\nCuando aumenta la tensión en F (consecuentemente, en B),\naumenta la corriente que conduce T2, pero la corriente de emisor\ntiene que permanecer constante.\nEn consecuencia, T1 tiene que reducir la corriente que conduce\npara compensar.\nEsto se refleja como una reducción de la tensión en R5, que es la misma\ntensión que hay en el punto E.\nEsta señal ya es la señal de error, la comparación de tensión se hizo en el diferencial:\nEntro una tensión en B, y consecuentemente, se produjo una señal de error \nen tensión en E, al comparar B con A.\nEN RESUMEN: MIDE TENSIÓN COMPARA TENSIÓN.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LA REALIMENTACIÓN SE DA DESDE EL PUNTO F\nMIDIENDO LA TENSIÓN DE SALIDA, PASANDO POR UN\nBLOQUE BETA QUE ES UN DIVISOR RESISITVO,\nY SE REALIMENTA TENSIÓN.\nCOMO VEO QUE SE REALIMENTA TENSIÓN?\nEN REALIDAD NO ESTOY MUY SEGURO ASI QUE VAMOS A \nANALIZAR:\nEl diferencial tiene una corriente de emisor fija.\nCuando aumenta la tensión en F (consecuentemente, en B),\naumenta la corriente que conduce T2, pero la corriente de emisor\ntiene que permanecer constante.\nEn consecuencia, T1 tiene que reducir la corriente que conduce\npara compensar.\nEsto se refleja como una reducción de la tensión en R5, que es la misma\ntensión que hay en el punto E.\nEsta señal ya es la señal de error, la comparación de tensión se hizo en el diferencial:\nEntro una tensión en B, y consecuentemente, se produjo una señal de error \nen tensión en E, al comparar B con A.\nEN RESUMEN: MIDE TENSIÓN COMPARA TENSIÓN.",
      "autoResize": true,
      "lineHeight": 1.35
    },
