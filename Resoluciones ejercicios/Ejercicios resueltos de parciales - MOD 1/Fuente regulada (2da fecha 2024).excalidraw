    {
      "id": "yAW54fl2yMZ6JvHd-loiv",
      "type": "text",
      "x": 1011.4706129816636,
      "y": 652.5300596934428,
      "width": 1405.799072265625,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0ip",
      "roundness": null,
      "seed": 1010096623,
      "version": 727,
      "versionNonce": 1172539343,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1739624375569,
      "link": null,
      "locked": false,
      "text": "Método de la perturbación:\n\n1- Aumenta la tensión V0\n2- Aumenta la tensión en el divisor resistivo R2/R1\n3- Aumenta la tensión en V+ del operacional\n4- Aumenta la tensión en la base del transistor del operacional\n5- Aumenta la corriente del transistor, que es la misma que pasa por R\n6- Disminuye la tensión en la base de Q1 (ya que es Vnr-I_r*R)\n7- Disminuye la cirriente que inyecta el Darlington a la carga\n8- Disminuye la tensión V0\n\nOsea está realimentado negativamente, funciona, no hay que modificarlo.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Método de la perturbación:\n\n1- Aumenta la tensión V0\n2- Aumenta la tensión en el divisor resistivo R2/R1\n3- Aumenta la tensión en V+ del operacional\n4- Aumenta la tensión en la base del transistor del operacional\n5- Aumenta la corriente del transistor, que es la misma que pasa por R\n6- Disminuye la tensión en la base de Q1 (ya que es Vnr-I_r*R)\n7- Disminuye la cirriente que inyecta el Darlington a la carga\n8- Disminuye la tensión V0\n\nOsea está realimentado negativamente, funciona, no hay que modificarlo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
