    {
      "id": "YD7WUirOo-79a_oLILZ89",
      "type": "text",
      "x": 2119.4347459696532,
      "y": 1050.6316156487508,
      "width": 1703.9993286132812,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c3KN",
      "roundness": null,
      "seed": 1107291404,
      "version": 915,
      "versionNonce": 1073086772,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1738352113714,
      "link": null,
      "locked": false,
      "text": "En lista:\n\nC: Es el dispositivo que se carga y se descarga de forma lineal, creando\n   la salida triangular como tensión en sus terminales.\nR1, R2: Divisor resistivo, toma una fracción de Vz y lo utliza como referencia\n   en el terminal positivo. La señal triangular va a alcanzar como valores\n   pico (Vz*R1)/(R1+R2)\nR3: Calculo que es para no poner el operacional directamente a tierra (diodos).\nDz1, Dz2: Fijan una tensión que se utliza como referencia (mediante una constante)\n   para los máximos de la triangular. Además si se quiere tomar la cuadrada, tendrá\n   como picos +-Vz.\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En lista:\n\nC: Es el dispositivo que se carga y se descarga de forma lineal, creando\n   la salida triangular como tensión en sus terminales.\nR1, R2: Divisor resistivo, toma una fracción de Vz y lo utliza como referencia\n   en el terminal positivo. La señal triangular va a alcanzar como valores\n   pico (Vz*R1)/(R1+R2)\nR3: Calculo que es para no poner el operacional directamente a tierra (diodos).\nDz1, Dz2: Fijan una tensión que se utliza como referencia (mediante una constante)\n   para los máximos de la triangular. Además si se quiere tomar la cuadrada, tendrá\n   como picos +-Vz.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
