      "angle": 0,
      "x": 1721.5513062591658,
      "y": 8511.73982959064,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1307.375732421875,
      "height": 291.6,
      "seed": 1580760439,
      "groupIds": [],
