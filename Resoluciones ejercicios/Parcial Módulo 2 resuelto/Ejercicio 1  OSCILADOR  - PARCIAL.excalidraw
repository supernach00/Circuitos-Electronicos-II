    {
      "id": "3ssGS_qrRRdUX36PvcEU9",
      "type": "text",
      "x": 1828.5,
      "y": 251,
      "width": 1207.999267578125,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
