      "isDeleted": false,
      "boundElements": null,
      "updated": 1739112389691,
      "link": null,
      "locked": false,
      "text": "En el caso en el que se entrega mayor potencia (SW2), \nel Motor cumple con los requisitos nominales para funcionar\n(30V RMS, 300mA RMS)",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En el caso en el que se entrega mayor potencia (SW2), \nel Motor cumple con los requisitos nominales para funcionar\n(30V RMS, 300mA RMS)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UP-FVoDAIAj9sFRkNk_iT",
      "type": "text",
      "x": 3044.219132944183,
      "y": 6979.66785847797,
      "width": 1247.3994140625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
