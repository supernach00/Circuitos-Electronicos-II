      "index": "c8qF",
      "roundness": null,
      "seed": 677560680,
      "version": 264,
      "versionNonce": 1204655976,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1739112389691,
      "link": null,
      "locked": false,
      "text": "En el caso en el que se entrega menor potencia (SW1), el motor \nsigue cumpliendo los requisitos nominales para funcionar,\ncon lo justo",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
