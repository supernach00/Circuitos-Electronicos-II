    {
      "id": "QRsmkDzHE8JLWNdr6UUDR",
      "type": "text",
      "x": 3042.489335877758,
      "y": 1092.1109912977793,
      "width": 1180.134033203125,
      "height": 124.77544189861442,
      "angle": 0,
