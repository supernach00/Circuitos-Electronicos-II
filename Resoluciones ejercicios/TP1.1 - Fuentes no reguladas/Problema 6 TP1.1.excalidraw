    {
      "id": "c4c-ZjEMswBiOLeNwiIQq",
      "type": "text",
      "x": 2958.6806417257135,
      "y": 6410.500431705606,
      "width": 1180.134033203125,
      "height": 124.77544189861442,
      "angle": 0,
