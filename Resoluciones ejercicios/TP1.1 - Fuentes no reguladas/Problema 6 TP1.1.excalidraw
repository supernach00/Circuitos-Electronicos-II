    {
      "id": "Lo2uTHvtgJYrBrQJ48ect",
      "type": "text",
      "x": 4050.4040273787914,
      "y": 4777.380075903734,
      "width": 575.399658203125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cNKY",
      "roundness": null,
      "seed": 760590340,
      "version": 242,
      "versionNonce": 1258257540,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1739379623139,
      "link": null,
      "locked": false,
      "text": "Según lo predicho, \npara una Rs tan chica\nla corriente pico incial\npor el capacitor es enorme.\nNo hay capacitor que se la \nbanque, toca rehacer todo con\nuna Rs más realista.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
